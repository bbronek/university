#!/usr/bin/env python3
import sys


def parse_automaton(path):
    transitions = {}
    accepting = set()
    with open(path, encoding="utf-8") as source:
        for number, line in enumerate(source, 1):
            fields = line.split()
            if not fields:
                continue
            if len(fields) == 1:
                accepting.add(fields[0])
            elif len(fields) == 3 and len(fields[2]) == 1:
                start, end, character = fields
                transitions.setdefault((start, character), set()).add(end)
            else:
                raise ValueError(f"Invalid automaton rule on line {number}")
    return transitions, accepting


def accepts(word, transitions, accepting):
    states = {"0"}
    for character in word:
        states = {
            destination
            for state in states
            for destination in transitions.get((state, character), ())
        }
        if not states:
            return False
    return bool(states & accepting)


def main():
    if len(sys.argv) != 2:
        raise SystemExit("Usage: run <automaton file>")
    transitions, accepting = parse_automaton(sys.argv[1])
    for line in sys.stdin:
        print("yes" if accepts(line.rstrip("\r\n"), transitions, accepting) else "no")


if __name__ == "__main__":
    main()
